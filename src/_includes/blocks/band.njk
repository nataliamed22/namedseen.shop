<div class="band"{% if block.anchor %} id="{{ block.anchor }}"{% endif %}>
  <div class="wrap">
    {% if block.eyebrow %}<div class="label">{{ block.eyebrow }}</div>{% endif %}
    <h2 class="display">{{ block.title | accent | safe }}</h2>
    {% if block.text %}<p>{{ block.text }}</p>{% endif %}
    {% if block.button_label %}<a href="{{ block.button_url }}"{% if "http" in block.button_url %} target="_blank" rel="noopener"{% endif %} class="btn">{{ block.button_label }}</a>{% endif %}
  </div>
</div>
