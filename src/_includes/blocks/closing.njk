<div class="wrap closing"{% if block.anchor %} id="{{ block.anchor }}"{% endif %}>
  {% if block.eyebrow %}<div class="label">{{ block.eyebrow }}</div>{% endif %}
  <h2 class="display">{{ block.title | accent | safe }}</h2>
  {% if block.text %}<p>{{ block.text }}</p>{% endif %}
  {% if block.button_label %}<div class="acts"><a href="{{ block.button_url }}" class="btn solid">{{ block.button_label }}</a></div>{% endif %}
</div>
